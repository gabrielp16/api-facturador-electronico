    "adm-zip": "^0.6.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "dotenv": "^16.6.1",
    "joi": "^18.0.1",
    "mongoose": "^8.16.4",
    "node-forge": "^1.3.1",
    "nodemailer": "^10.0.10",
    "pdfkit": "^0.17.1",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "soap": "^1.4.0",
