# =========================
# DIAN e-invoicing (testing)
# Copy this file to .env and replace all placeholder values.
# =========================

NODE_ENV=development
PORT=3002
API_PREFIX=api/v1
MONGODB_URI=mongodb://localhost:27017/morchis-dian
LOG_LEVEL=log

# -------------------------
# DIAN core
# -------------------------
DIAN_ENVIRONMENT=testing
DIAN_PROFILE_EXECUTION_ID=2
DIAN_SEND_MODE=sync
DIAN_SOFTWARE_ID=REPLACE_WITH_DIAN_SOFTWARE_ID
DIAN_SOFTWARE_PIN=REPLACE_WITH_DIAN_SOFTWARE_PIN
DIAN_TEST_SET_ID=REPLACE_WITH_DIAN_TEST_SET_ID

DIAN_WSDL_TEST=https://vpfe-hab.dian.gov.co/WcfDianCustomerServices.svc?wsdl
DIAN_WSDL_PROD=https://vpfe.dian.gov.co/WcfDianCustomerServices.svc?wsdl

# SOAP resilience (recommended)
DIAN_SOAP_TIMEOUT_MS=20000
DIAN_SOAP_MAX_RETRIES=2
DIAN_SOAP_RETRY_BASE_MS=400
DIAN_SOAP_RETRY_MAX_MS=4000

# -------------------------
# DIAN WS-Security (enable only if required by your DIAN setup)
# -------------------------
DIAN_WS_SECURITY_ENABLED=false
DIAN_WS_SECURITY_USERNAME=
DIAN_WS_SECURITY_PASSWORD=
DIAN_WS_SECURITY_MUST_UNDERSTAND=true
DIAN_WS_SECURITY_HAS_TIMESTAMP=true
DIAN_WS_SECURITY_HAS_NONCE=true

# Async reconciliation worker
DIAN_ASYNC_RECONCILIATION_ENABLED=false
DIAN_ASYNC_RECONCILIATION_INTERVAL_MS=60000
DIAN_ASYNC_RECONCILIATION_BATCH_SIZE=20

# -------------------------
# Reprocess policy (optional)
# -------------------------
DIAN_REPROCESS_ALLOWED_STATUS_CODES=
DIAN_REPROCESS_BLOCKED_STATUS_CODES=
DIAN_REPROCESS_BLOCKED_RULE_PREFIXES=
DIAN_REPROCESS_REQUIRE_APPROVAL_FOR_BLOCKED=true

# -------------------------
# Company (issuer) data
# -------------------------
DIAN_COMPANY_NIT=REPLACE_WITH_COMPANY_NIT
DIAN_COMPANY_DV=REPLACE_WITH_COMPANY_DV
DIAN_COMPANY_NAME=REPLACE_WITH_COMPANY_NAME
DIAN_COMPANY_REGIME=48
DIAN_COMPANY_TAX_LEVEL=O-13
DIAN_COMPANY_RESPONSIBILITY=R-99-PN
DIAN_COMPANY_PHONE=REPLACE_WITH_COMPANY_PHONE
DIAN_COMPANY_EMAIL=REPLACE_WITH_COMPANY_EMAIL
DIAN_COMPANY_ADDRESS=REPLACE_WITH_COMPANY_ADDRESS
DIAN_COMPANY_CITY_CODE=11001
DIAN_COMPANY_CITY_NAME=Bogota
DIAN_COMPANY_DEPARTMENT_CODE=11
DIAN_COMPANY_DEPARTMENT_NAME=Bogota D.C.
DIAN_COMPANY_COUNTRY_CODE=CO
DIAN_COMPANY_COUNTRY_NAME=Colombia
DIAN_COMPANY_MUNICIPALITY_CODE=11001

# -------------------------
# Resolution data
# -------------------------
DIAN_RESOLUTION_NUMBER=REPLACE_WITH_RESOLUTION_NUMBER
DIAN_RESOLUTION_PREFIX=SETP
DIAN_RESOLUTION_FROM=1
DIAN_RESOLUTION_TO=500000
DIAN_RESOLUTION_VALID_FROM=2026-01-01
DIAN_RESOLUTION_VALID_TO=2026-12-31
DIAN_TECHNICAL_KEY=REPLACE_WITH_DIAN_TECHNICAL_KEY

DIAN_QR_TEST_URL=https://catalogo-vpfe-hab.dian.gov.co/document/searchqr?documentkey=
DIAN_QR_PROD_URL=https://catalogo-vpfe.dian.gov.co/document/searchqr?documentkey=

# -------------------------
# Certificate (signing)
# -------------------------
CERTIFICATE_PATH=./certs/dian-certificate.p12
CERTIFICATE_PASSPHRASE=REPLACE_WITH_CERTIFICATE_PASSPHRASE

# -------------------------
# Mail transport
# -------------------------
MAIL_HOST=smtp.office365.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=REPLACE_WITH_MAIL_USER
MAIL_PASS=REPLACE_WITH_MAIL_PASS
MAIL_FROM=Facturacion Morchis <facturacion@yourdomain.com>

# -------------------------
# App/runtime
# -------------------------
PDF_OUTPUT_DIR=./tmp/pdf
POS_PRINTER_WIDTH_MM=80

# Protect invoice endpoints
INVOICES_API_KEY=REPLACE_WITH_STRONG_INTERNAL_API_KEY

# -------------------------
# Audit artifact signature (CSV exports)
# -------------------------
CSV_SIGNATURE_ENABLED=true
CSV_SIGNATURE_HMAC_SECRET=REPLACE_WITH_MIN_16_CHAR_SECRET
CSV_SIGNATURE_KEY_ID=dian-testing-2026-09-v1
